{
  "name": "atavismo-frontend",
  "description": "Svelte frontend for Atavismo",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist node_modules",
    "dev": "run-script-os",
    "dev:default": "NODE_ENV=development && vite",
    "dev:win32": "set NODE_ENV=development && vite",
    "build": "vite build && node scripts/parsePath.js dist/index.html && rimraf ../backend/src/client/ && npm run copy-client",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "copy-client": "run-script-os",
    "copy-client:default": "mkdir -p ../backend/src/client && cp -rf dist/* ../backend/src/client/",
    "copy-client:win32": "xcopy dist\\* ..\\backend\\src\\client\\ /e /i /h",
    "lint": "npm run check && eslint --ext .js,.ts,.svelte src"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@sveltestrap/sveltestrap": "^7.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "eslint": "^8.57.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-svelte": "^3.23.1",
    "rimraf": "^6.1.3",
    "run-script-os": "^1.1.6",
    "sass": "^1.74.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-i18n": "^4.0.0",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "npx eslint --fix"
    ]
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0"
  }
}
